# Hoist Prisma packages to the root node_modules so that bundled output
# (tsup with @prisma/client marked external) can resolve them at runtime
# regardless of which package originally declared the dependency.
# See: https://www.prisma.io/docs/guides/other/troubleshooting-orm/help-articles/nextjs-prisma-client-monorepo
public-hoist-pattern[]=@prisma/*
public-hoist-pattern[]=prisma
