# Hoist Prisma packages to the root node_modules so that Next.js (and tsup
# in the api package) can resolve @prisma/client at runtime regardless of
# which workspace package originally declared the dependency.
#
# This file mirrors the root .npmrc so that pnpm picks up the hoisting rules
# even when the working directory is apps/web (e.g. Vercel sets Root Directory
# to apps/web and runs `pnpm install` from there).
#
# See: https://www.prisma.io/docs/guides/other/troubleshooting-orm/help-articles/nextjs-prisma-client-monorepo
public-hoist-pattern[]=@prisma/*
public-hoist-pattern[]=prisma
