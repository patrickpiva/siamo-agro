# =============================================================================
# AgroLink — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com credenciais reais.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (servidor)
# Encontre em: Supabase Dashboard → Settings → API
# SUPABASE_SERVICE_ROLE_KEY tem permissões de admin — NUNCA exponha ao browser.
# -----------------------------------------------------------------------------
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# -----------------------------------------------------------------------------
# Supabase (browser / Realtime)
# Estas variáveis são expostas ao cliente via Next.js (prefixo NEXT_PUBLIC_).
#
# NEXT_PUBLIC_SUPABASE_URL
#   Derivado automaticamente de SUPABASE_URL pelo next.config.ts.
#   Não é necessário duplicar a entrada.
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY
#   Chave "anon / public" — encontre em Dashboard → Settings → API → Project API keys.
#   NÃO é a service_role key. É seguro expor ao browser: o Supabase usa
#   Row Level Security (RLS) para controlar o que cada usuário pode acessar.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Database — Supabase Dashboard → Settings → Database → Connection string
# Connection pooling via PgBouncer — usar nas queries (API + Server Actions)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta — necessária para Prisma Migrate e prisma db push
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# Auth (JWT)
# Gere com: openssl rand -hex 64
# -----------------------------------------------------------------------------
JWT_SECRET="troque-por-um-segredo-forte-em-producao"

# -----------------------------------------------------------------------------
# API Fastify (apps/api — porta 3001)
# -----------------------------------------------------------------------------
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# -----------------------------------------------------------------------------
# Web Next.js (apps/web — porta 3000)
#
# API_URL
#   URL da API Fastify usada pelo servidor Next.js (Route Handlers, Server
#   Components). Nunca exposto ao browser. Em produção: URL interna do serviço.
#   O next.config.ts deriva NEXT_PUBLIC_API_URL deste valor automaticamente,
#   então não é necessário duplicar a entrada.
#
# NEXT_PUBLIC_APP_URL
#   URL pública da aplicação web. Usada em links de notificação e CORS da API.
# -----------------------------------------------------------------------------
API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# WhatsApp / OTP
# WHATSAPP_PROVIDER: 'twilio' | 'evolution'
# -----------------------------------------------------------------------------
WHATSAPP_PROVIDER=twilio

# Twilio — obtenha em console.twilio.com
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="sua_auth_token_twilio"

# Número de origem com prefixo whatsapp:
# Sandbox: whatsapp:+14155238886
# Produção: whatsapp:+55...
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Content Template SID (HX...) — resolve "Outside messaging window"
# Crie em: console.twilio.com → Messaging → Content Template Builder
# Tipo: Authentication | Variável {{1}} = código OTP
# Obrigatório para produção; recomendado no sandbox.
TWILIO_CONTENT_SID=""

# -----------------------------------------------------------------------------
# Web Push (VAPID) — para notificações push via Service Worker
# Gere com: npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY fica apenas no servidor (API). NEXT_PUBLIC_VAPID_KEY vai ao browser.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_KEY="BExampleVAPIDPublicKeyBase64UrlEncoded..."
VAPID_PRIVATE_KEY="ExampleVAPIDPrivateKeyBase64UrlEncoded..."
VAPID_SUBJECT="mailto:suporte@agrolink.com.br"

# -----------------------------------------------------------------------------
# Contas demo (opcional)
# Lista de telefones que aceitam um OTP fixo — sem envio real via WhatsApp.
# Útil para QA, demos e onboarding de devs. Deixe em branco para desativar.
# DEMO_OTP deve ser tratado como senha: não commite o valor real, rotacione periodicamente.
# -----------------------------------------------------------------------------
DEMO_PHONES="+5511999990001,+5511999990002,+5511999990003"
DEMO_OTP=""
