# =============================================================================
# AgroLink — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Database)
# Encontre em: Supabase Dashboard → Settings → Database → Connection string
# -----------------------------------------------------------------------------
# Connection pooling (use para a API / Prisma em produção)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (necessária para Prisma Migrate)
DIRECT_URL="postgresql://postgres.[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# API (apps/api)
# -----------------------------------------------------------------------------
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# -----------------------------------------------------------------------------
# Web (apps/web)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
