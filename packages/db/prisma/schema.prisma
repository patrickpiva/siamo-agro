generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // URL com connection pooling (PgBouncer) — usar nas queries
  url       = env("DATABASE_URL")
  // URL direta — necessária para prisma migrate diff
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ProfileType {
  PRODUCER
  PROVIDER
}

enum BadgeTier {
  NONE
  BRONZE
  SILVER
  GOLD
}

enum ListingKind {
  OFFER
  DEMAND
  SERVICE
  EQUIPMENT
}

enum ServiceCategory {
  MACHINERY
  PEST_CONTROL
  CONSULTING
  LOGISTICS
  SOIL_ANALYSIS
  IRRIGATION
  OTHER
}

enum ListingStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum TransactionStatus {
  PROPOSED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CancellationReason {
  NO_RESPONSE
  PRICE_DISAGREEMENT
  QUALITY_ISSUE
  CHANGED_MIND
  OTHER
}

enum NotificationType {
  PROPOSAL_RECEIVED
  PROPOSAL_ACCEPTED
  PROPOSAL_REFUSED
  TRANSACTION_COMPLETED
  RATING_RECEIVED
  MATCH_FOUND
  COLLECTIVE_UPDATE
  SYSTEM
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  phone        String?    @unique @map("phone")
  email        String?    @unique @map("email")
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(ACTIVE) @map("status")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  profile            Profile?
  refreshTokens      RefreshToken[]
  buyerTransactions  Transaction[]        @relation("BuyerTransactions")
  sellerTransactions Transaction[]        @relation("SellerTransactions")
  sentMessages       TransactionMessage[] @relation("SentMessages")
  notifications      Notification[]
  savedListings      SavedListing[]

  @@map("users")
}

// ─── Profile ──────────────────────────────────────────────────────────────────

model Profile {
  id            String      @id @default(cuid())
  userId        String      @unique @map("user_id")
  type          ProfileType @map("type")
  name          String      @map("name")
  propertyName  String?     @map("property_name")
  photo         String?     @map("photo")
  bio           String?     @map("bio")
  currentRating Float       @default(0) @map("current_rating")
  ratingCount   Int         @default(0) @map("rating_count")
  badge         BadgeTier   @default(NONE) @map("badge")

  // LGPD — momento em que o usuário aceitou cada documento
  termsAcceptedAt        DateTime? @map("terms_accepted_at")
  privacyAcceptedAt      DateTime? @map("privacy_accepted_at")
  marketingWhatsappOptInAt DateTime? @map("marketing_whatsapp_opt_in_at")

  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  location                Location?
  listings                Listing[]
  matchScores             MatchScore[]            @relation("CandidateMatchScores")
  notificationPreference  NotificationPreference?

  @@map("profiles")
}

// ─── Location ─────────────────────────────────────────────────────────────────

model Location {
  id        String   @id @default(cuid())
  profileId String   @unique @map("profile_id")
  latitude  Float    @map("latitude")
  longitude Float    @map("longitude")
  city      String   @map("city")
  state     String   @map("state")
  // ATENÇÃO: a coluna `geog geography(Point,4326)` NÃO é declarada aqui.
  // Ela é adicionada via migration SQL manual (migrations/manual/001_postgis.sql).
  // Um trigger mantém `geog` sincronizado automaticamente com latitude/longitude.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("locations")
}

// ─── Listing ──────────────────────────────────────────────────────────────────

model Listing {
  id          String          @id @default(cuid())
  profileId   String          @map("profile_id")
  kind        ListingKind   @map("kind")
  category    String        @map("category")
  title       String        @map("title")
  description String        @map("description")
  price       Decimal?      @map("price") @db.Decimal(12, 2)
  negotiable  Boolean       @default(false) @map("negotiable")
  status      ListingStatus @default(ACTIVE) @map("status")
  viewCount   Int           @default(0) @map("view_count")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  profile      Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  photos       ListingPhoto[]
  transactions Transaction[]
  matchScores  MatchScore[]
  savedBy      SavedListing[]

  @@index([profileId])
  @@index([kind, status])
  @@map("listings")
}

// ─── ListingPhoto ─────────────────────────────────────────────────────────────

model ListingPhoto {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  url       String   @map("url")
  order     Int      @map("sort_order") // sort_order evita conflito com palavra reservada SQL
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_photos")
}

// ─── Transaction ──────────────────────────────────────────────────────────────

model Transaction {
  id        String            @id @default(cuid())
  shortId   Int               @unique @default(autoincrement()) @map("short_id")
  listingId String            @map("listing_id")
  buyerId   String            @map("buyer_id")
  sellerId  String            @map("seller_id")
  amount    Decimal           @map("amount") @db.Decimal(12, 2)
  status    TransactionStatus @default(PROPOSED) @map("status")

  // Dual-party confirmation for start (ACCEPTED → IN_PROGRESS)
  buyerConfirmedStart  Boolean  @default(false) @map("buyer_confirmed_start")
  sellerConfirmedStart Boolean  @default(false) @map("seller_confirmed_start")

  // Dual-party confirmation for completion (IN_PROGRESS → COMPLETED)
  buyerConfirmedEnd  Boolean  @default(false) @map("buyer_confirmed_end")
  sellerConfirmedEnd Boolean  @default(false) @map("seller_confirmed_end")

  // Cancellation tracking
  cancelledById      String?            @map("cancelled_by_id")
  cancellationReason CancellationReason? @map("cancellation_reason")
  cancelledAt        DateTime?          @map("cancelled_at")

  // 72h completion timer: set when first party confirms completion
  completionFirstConfirmedAt DateTime? @map("completion_first_confirmed_at")

  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  // Restrict impede exclusão de anúncio/usuário com transações vinculadas
  listing  Listing              @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer    User                 @relation("BuyerTransactions", fields: [buyerId], references: [id], onDelete: Restrict)
  seller   User                 @relation("SellerTransactions", fields: [sellerId], references: [id], onDelete: Restrict)
  messages TransactionMessage[]
  ratings  Rating[]

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@map("transactions")
}

// ─── TransactionMessage ───────────────────────────────────────────────────────

model TransactionMessage {
  id            String   @id @default(cuid())
  transactionId String   @map("transaction_id")
  senderId      String   @map("sender_id")
  content       String   @map("content")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  sender      User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([senderId])
  @@map("transaction_messages")
}

// ─── Rating ───────────────────────────────────────────────────────────────────

model Rating {
  id            String  @id @default(cuid())
  transactionId String  @map("transaction_id")
  raterId       String  @map("rater_id")   // userId de quem avalia
  rateeId       String  @map("ratee_id")   // userId de quem é avaliado
  score         Int     @map("score")       // 1–5
  comment       String? @map("comment")
  reliability   Int?    @map("reliability")   // 1–5 ou null
  communication Int?    @map("communication") // 1–5 ou null
  quality       Int?    @map("quality")       // 1–5 ou null
  weight        Float   @default(1.0) @map("weight")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, raterId]) // uma avaliação por rater por transação
  @@index([rateeId])
  @@map("ratings")
}

// ─── MatchScore ───────────────────────────────────────────────────────────────

model MatchScore {
  id                 String   @id @default(cuid())
  listingId          String   @map("listing_id")
  candidateProfileId String   @map("candidate_profile_id")
  score              Float    @map("score")
  distanceKm         Float?   @map("distance_km")
  computedAt         DateTime @map("computed_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  listing          Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  candidateProfile Profile @relation("CandidateMatchScores", fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([candidateProfileId])
  @@map("match_scores")
}

// ─── RefreshToken ─────────────────────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash") // bcrypt hash do token opaco
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── OtpCode ──────────────────────────────────────────────────────────────────

model OtpCode {
  id        String    @id @default(cuid())
  phone     String    @map("phone")
  code      String    @map("code")
  expiresAt DateTime  @map("expires_at")
  attempts  Int       @default(0) @map("attempts")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([phone])
  @@map("otp_codes")
}

// ─── Notification ─────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType @map("type")
  read      Boolean          @default(false) @map("read")
  data      Json             @default("{}") @map("data")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@map("notifications")
}

// ─── SavedListing ─────────────────────────────────────────────────────────────

model SavedListing {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  listingId String   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@map("saved_listings")
}

// ─── NotificationPreference ───────────────────────────────────────────────────

model NotificationPreference {
  id               String  @id @default(cuid())
  profileId        String  @unique @map("profile_id")
  whatsapp         Boolean @default(true) @map("whatsapp")
  push             Boolean @default(true) @map("push")
  proposalReceived Boolean @default(true) @map("proposal_received")
  transactionUpdate Boolean @default(true) @map("transaction_update")
  matchFound       Boolean @default(true) @map("match_found")
  ratingReceived   Boolean @default(true) @map("rating_received")
  collectiveUpdate Boolean @default(true) @map("collective_update")
  weeklyTips       Boolean @default(false) @map("weekly_tips")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
