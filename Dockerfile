FROM node:22-alpine
WORKDIR /app

# Enable pnpm via corepack
RUN corepack enable

# Copy workspace manifests first — Docker caches this layer until any
# package.json or lockfile changes, skipping the expensive pnpm install.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/db/package.json ./packages/db/
COPY packages/shared/package.json ./packages/shared/
COPY packages/ui/package.json ./packages/ui/

# Prisma schema must exist before pnpm install so the packages/db
# postinstall hook (prisma generate) can find it.
COPY packages/db/prisma/ ./packages/db/prisma/

RUN pnpm install --frozen-lockfile

# Copy full source (after install so the layer above stays cached)
COPY . .

# Bundle the API with tsup.
# --filter @agraia/api limits the build to the API — Next.js web app is never invoked.
# Prisma client was already generated by the packages/db postinstall hook above.
RUN pnpm --filter @agraia/api build

ENV NODE_ENV=production

# Default entry point (Railway overrides this per-service via startCommand).
CMD ["node", "apps/api/dist/index.js"]
