{
  "name": "siamoagro",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\"",
    "prepare": "husky",
    "db:generate": "pnpm --filter @siamo/db db:generate",
    "db:migrate:diff": "pnpm --filter @siamo/db db:migrate:diff",
    "db:migrate:diff:inc": "pnpm --filter @siamo/db db:migrate:diff:inc",
    "db:migrate:deploy": "pnpm --filter @siamo/db db:migrate:deploy",
    "db:seed": "pnpm --filter @siamo/db db:seed",
    "db:studio": "pnpm --filter @siamo/db db:studio",
    "db:reset": "pnpm --filter @siamo/db db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "globals": "^15.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write"
    ]
  }
}
